{
  "name": "mifun-storage",
  "version": "1.0.0",
  "private": true,
  "license": "MIT",
  "description": "米饭云盘-小文件tg存储系统",
  "type": "module",
  "scripts": {
    "postinstall": "npm run prisma:generate",
    "predev": "npm run css:build",
    "dev": "concurrently --kill-others --names css,server \"npm:css:watch\" \"tsx watch src/server.ts\"",
    "build": "npm run css:build && tsc -p tsconfig.build.json",
    "start": "node dist/server.js",
    "css:build": "tailwindcss --minify -c tailwind.config.cjs -i ./web/tailwind.input.css -o ./web/tailwind.css",
    "css:watch": "tailwindcss -c tailwind.config.cjs -i ./web/tailwind.input.css -o ./web/tailwind.css --watch",
    "crawl:albums": "tsx src/scripts/random-album-crawler.ts",
    "crawl:mukyu": "tsx src/scripts/mukyu-image-crawler.ts",
    "db:mysql-to-sqlite": "tsx src/scripts/mysql-to-sqlite.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "prisma:generate": "prisma generate && prisma generate --schema prisma/sqlite/schema.prisma",
    "prisma:migrate": "prisma migrate dev",
    "prisma:deploy": "prisma migrate deploy"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "dependencies": {
    "@fastify/multipart": "10.1.0",
    "@fastify/static": "10.1.2",
    "@prisma/client": "6.19.3",
    "dotenv": "17.2.1",
    "fastify": "5.10.0",
    "grammy": "1.45.1",
    "zod": "4.1.5"
  },
  "devDependencies": {
    "@types/node": "24.3.0",
    "concurrently": "^9.2.1",
    "prisma": "6.19.3",
    "tailwindcss": "^3.4.17",
    "tsx": "4.20.5",
    "typescript": "7.0.2",
    "vitest": "4.1.10"
  }
}
