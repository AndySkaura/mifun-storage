{
  "name": "tgfs",
  "version": "1.0.0",
  "private": true,
  "description": "米饭云盘-小文件tg存储系统",
  "type": "module",
  "scripts": {
    "postinstall": "npm run prisma:generate",
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/server.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "prisma:generate": "prisma generate && prisma generate --schema prisma/sqlite/schema.prisma",
    "prisma:migrate": "prisma migrate dev",
    "prisma:deploy": "prisma migrate deploy"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "dependencies": {
    "@fastify/multipart": "10.1.0",
    "@fastify/static": "10.1.2",
    "@prisma/client": "6.19.3",
    "dotenv": "17.2.1",
    "fastify": "5.10.0",
    "grammy": "1.45.1",
    "zod": "4.1.5"
  },
  "devDependencies": {
    "@types/node": "24.3.0",
    "prisma": "6.19.3",
    "tsx": "4.20.5",
    "typescript": "7.0.2",
    "vitest": "4.1.10"
  }
}
