# HTTP 服务监听端口和地址。
PORT=3000
HOST=0.0.0.0

# 数据库配置：
# - 不设置或留空时自动使用 SQLite，数据库文件为 data/tgfs.db。
# - Docker 部署时 SQLite 位于 /app/data/tgfs.db，请持久化挂载 /app/data。
# - 如需使用 MySQL 8.x，取消下面一行注释并修改账号、密码和地址。
# DATABASE_URL=mysql://tgfs:tgfs@localhost:3306/tgfs

# Telegram Bot Token，可从 @BotFather 获取。
TELEGRAM_BOT_TOKEN=replace-with-bot-token

# 用于保存文件的 Telegram Channel ID。
# Bot 必须已加入该频道并拥有发布消息权限。
TELEGRAM_STORAGE_CHAT_ID=-1001234567890

# 管理员鉴权 Token。保持注释或设置为空表示关闭管理员鉴权。
# 生产环境建议使用 `openssl rand -hex 32` 生成后取消注释并填写。
# ADMIN_TOKEN=

# 单个文件上传和下载大小上限，单位为字节。
# 默认分别为 50 MiB 和 20 MiB。
MAX_UPLOAD_SIZE=52428800
MAX_DOWNLOAD_SIZE=20971520
